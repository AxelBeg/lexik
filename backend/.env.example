# Base
DB_USER=lexik
DB_PASSWORD=change-moi
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lexik
# ou directement :
# DATABASE_URL=postgresql://lexik:pass@localhost:5432/lexik

# Auth
JWT_SECRET=genere-une-valeur-aleatoire-longue

# Play Games Services : client OAuth "Web" du projet Google Cloud lie a la
# Play Console. Sans ces deux valeurs, seul le mode repli (device) fonctionne.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Modele
LEXIK_MODELS_DIR=./models
LEXIK_MODEL_FILE=cc.fr.300.bin

# --- Developpement sans modele ni Postgres ---
# LEXIK_FAKE_ENGINE=1 remplace fastText par un hachage deterministe :
# toute la boucle de jeu tourne, les scores nʼont aucun sens semantique.
# LEXIK_FAKE_ENGINE=1
# DATABASE_URL=sqlite:///./lexik_dev.db
